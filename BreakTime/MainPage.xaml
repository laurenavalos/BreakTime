<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BreakTime.MainPage" Title="Break Time" x:Name="frmMain">

    <StackLayout>
        <Label x:Name="lblDisplay" Text="Start Break Time Timer" Margin="0,60,0,100" FontSize="Title" HorizontalTextAlignment="Center"/>
        <Button  x:Name="btn5" Text="Take 5" Clicked="Btn5_OnClicked"/>
        <Button Text="Take 10" Clicked="Btn10_OnClicked"/>
        <Button Text="Take 15" Clicked="Btn15_OnClicked"/>
        <Button Text="Reset" Clicked="Reset_OnClicked" Margin="0, 15" BackgroundColor="Orange" TextColor="Black"/>
    </StackLayout>

</ContentPage>
